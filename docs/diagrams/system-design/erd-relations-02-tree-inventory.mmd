---
config:
  theme: base
  look: classic
  themeVariables:
    background: '#FFFFFF'
    primaryColor: '#F0FDF4'
    primaryTextColor: '#1F2937'
    primaryBorderColor: '#15803D'
    lineColor: '#64748B'
    fontFamily: Arial
  flowchart:
    curve: basis
    nodeSpacing: 45
    rankSpacing: 55
    diagramPadding: 28
---
flowchart LR
%% Garis menghubungkan kolom FK ke kolom PK atau UK yang dirujuk.
  subgraph tbl_tree_species["tree_species"]
    direction TB
    field_tree_species_id["id · PK"]:::pk
  end
  subgraph tbl_plots["plots"]
    direction TB
    field_plots_id["id · PK"]:::pk
  end
  subgraph tbl_planting_batches["planting_batches"]
    direction TB
    field_planting_batches_id["id · PK"]:::pk
    field_planting_batches_plot_id["plot_id · FK/UK"]:::fk
  end
  subgraph tbl_trees["trees"]
    direction TB
    field_trees_id["id · PK"]:::pk
    field_trees_batch_id["batch_id · FK"]:::fk
    field_trees_plot_id["plot_id · FK"]:::fk
    field_trees_species_id["species_id · FK"]:::fk
  end
  field_plots_id -->|"1 : 0..*"| field_planting_batches_plot_id
  field_tree_species_id -->|"1 : 0..*"| field_trees_species_id
  field_plots_id -->|"1 : 0..*"| field_trees_plot_id
  field_planting_batches_id -->|"1 : 0..* komposit"| field_trees_batch_id
  field_planting_batches_plot_id -->|"1 : 0..* komposit"| field_trees_plot_id
  classDef pk fill:#DCFCE7,stroke:#15803D,stroke-width:2px,color:#14532D
  classDef fk fill:#EFF6FF,stroke:#2563EB,stroke-width:1.5px,color:#1E3A8A
  linkStyle default stroke:#64748B,stroke-width:1.8px
