classDiagram
%% M05 - Kelompok penanaman | HJK-013-HJK-015
direction LR
class PlantingBatch:::model {
  +bigint id
  +bigint plot_id
  +string code
  +date planted_on
  +text notes
  +plot() BelongsTo
  +trees() HasMany
}
class Plot:::shared {
  +bigint id
  +bigint site_id
  +string code
  +smallint capacity
}
class Tree:::shared {
  +bigint id
  +bigint plot_id
  +bigint batch_id
  +string code
  +date planted_on
}
Plot "1" --> "0..*" PlantingBatch : contains
PlantingBatch "0..1" --> "0..*" Tree : groups
Plot "1" --> "0..*" Tree : locates

classDef model fill:#DCFCE7,stroke:#15803D,stroke-width:2px,color:#1F2937
classDef shared fill:#F8FAFC,stroke:#64748B,color:#1F2937
classDef neighbor fill:#EFF6FF,stroke:#2563EB,color:#1F2937
classDef action fill:#FEF3C7,stroke:#D97706,stroke-width:2px,color:#1F2937
