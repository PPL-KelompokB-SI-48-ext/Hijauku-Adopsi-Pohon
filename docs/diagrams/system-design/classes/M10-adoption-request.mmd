config:
  theme: base
  look: classic
  class:
    useMaxWidth: true
  themeVariables:
    background: "#FFFFFF"
    primaryColor: "#F0FDF4"
    primaryTextColor: "#1F2937"
    primaryBorderColor: "#15803D"
    lineColor: "#64748B"
    fontFamily: "Arial"
---
classDiagram
%% M10 - Permohonan adopsi | HJK-028-HJK-030
direction LR
class AdoptionRequest:::model {
  +bigint id
  +bigint tree_id
  +bigint requester_id
  +text reason
  +string status
  +bigint reviewer_id
  +text decision_reason
  +tree() BelongsTo
  +requester() BelongsTo
  +reviewer() BelongsTo
  +agreement() HasOne
  +allocation() HasOne
}
class Tree:::shared {
  +bigint id
  +string code
  +string initial_condition
}
class User:::shared {
  +bigint id
  +string name
  +string role
}
class AdoptionAgreement:::neighbor {
  +bigint id
  +bigint request_id
  +string status
}
class TreeAdoptionAllocation:::neighbor {
  +bigint id
  +bigint request_id
  +bigint tree_id
  +string status
}
Tree "1" --> "0..*" AdoptionRequest : requested for
User "1" --> "0..*" AdoptionRequest : submits
User "0..1" --> "0..*" AdoptionRequest : reviews
AdoptionRequest "1" --> "0..1" AdoptionAgreement : may result in
AdoptionRequest "1" --> "0..1" TreeAdoptionAllocation : may reserve

classDef model fill:#DCFCE7,stroke:#15803D,stroke-width:2px,color:#1F2937
classDef shared fill:#F8FAFC,stroke:#64748B,color:#1F2937
classDef neighbor fill:#EFF6FF,stroke:#2563EB,color:#1F2937
classDef action fill:#FEF3C7,stroke:#D97706,stroke-width:2px,color:#1F2937
