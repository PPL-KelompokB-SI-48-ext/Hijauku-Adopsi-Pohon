---
config:
  theme: base
  look: classic
  class:
    useMaxWidth: true
  themeVariables:
    background: "#FFFFFF"
    primaryColor: "#F0FDF4"
    primaryTextColor: "#1F2937"
    primaryBorderColor: "#15803D"
    lineColor: "#64748B"
    fontFamily: "Arial"
---
classDiagram
%% M03 - Petak tanam | HJK-007-HJK-009
direction LR
class Plot:::model {
  +bigint id
  +bigint site_id
  +string code
  +smallint capacity
  +string status
  +site() BelongsTo
  +trees() HasMany
  +plantingBatches() HasMany
}
class Site:::shared {
  +bigint id
  +bigint program_id
  +string name
}
class PlantingBatch:::shared {
  +bigint id
  +bigint plot_id
  +string code
  +date planted_on
}
class Tree:::shared {
  +bigint id
  +bigint plot_id
  +bigint batch_id
  +string code
  +string initial_condition
}
Site "1" --> "0..*" Plot : contains
Plot "1" --> "0..*" PlantingBatch : groups
Plot "1" --> "0..*" Tree : locates
PlantingBatch "0..1" --> "0..*" Tree : groups

classDef model fill:#DCFCE7,stroke:#15803D,stroke-width:2px,color:#1F2937
classDef shared fill:#F8FAFC,stroke:#64748B,color:#1F2937
classDef neighbor fill:#EFF6FF,stroke:#2563EB,color:#1F2937
classDef action fill:#FEF3C7,stroke:#D97706,stroke-width:2px,color:#1F2937
