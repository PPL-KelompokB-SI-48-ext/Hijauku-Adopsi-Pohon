classDiagram
%% M09 - Penugasan lapangan | HJK-025-HJK-027
direction LR
class FieldAssignment:::model {
  +bigint id
  +bigint activity_id
  +bigint tree_id
  +bigint assignee_id
  +datetime due_at
  +string status
  +activity() BelongsTo
  +tree() BelongsTo
  +assignee() BelongsTo
}
class Activity:::shared {
  +bigint id
  +string title
  +string status
}
class Tree:::shared {
  +bigint id
  +string code
  +string initial_condition
}
class User:::shared {
  +bigint id
  +string name
  +string role
}
class CarePlan:::neighbor {
  +bigint id
  +bigint assignment_id
  +date planned_on
}
Activity "1" --> "0..*" FieldAssignment : schedules
Tree "1" --> "0..*" FieldAssignment : is assigned
User "1" --> "0..*" FieldAssignment : receives
FieldAssignment "0..1" --> "0..*" CarePlan : may support

classDef model fill:#DCFCE7,stroke:#15803D,stroke-width:2px,color:#1F2937
classDef shared fill:#F8FAFC,stroke:#64748B,color:#1F2937
classDef neighbor fill:#EFF6FF,stroke:#2563EB,color:#1F2937
classDef action fill:#FEF3C7,stroke:#D97706,stroke-width:2px,color:#1F2937
