 auth[shape=box,label="Autentikasi dan dashboard adalah fondasi.\nAkses dibatasi role, ownership, dan status; bukan sekadar menyembunyikan tombol.\nM16-M18 tidak termasuk scope aktif.",fillcolor="#F8FAFC"];catalog->auth[style=invis];}
