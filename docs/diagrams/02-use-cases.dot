digraph G {graph [bgcolor="white",pad="0.3",nodesep="0.4",ranksep="0.55",fontname="Arial",fontsize=22,labeljust=l,labelloc=t]; node [shape=box,style="rounded,filled",fillcolor="#F0FDF4",color="#15803D",fontname="Arial",fontsize=16,margin="0.18,0.12"]; edge [fontname="Arial",fontsize=12,color="#64748B"]; rankdir=LR;label="Aktor dan fitur aktif Hijauku";node[shape=ellipse];
 manager[shape=box,label="Pengelola\nmanager /app"];staff[shape=box,label="Petugas\nfield_staff /petugas"];citizen[shape=box,label="Warga\ncitizen /warga"];public[shape=box,label="Pengunjung publik"];
 data[label="M01-M06\nProgram, lokasi, petak, jenis,\nkelompok penanaman, inventaris"];
